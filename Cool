<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>The Matrix Hub // Cyber Security Dashboard</title>
    <style>
        :root {
            --primary: #00ff66;
            --bg-dark: #0a0a0a;
            --bg-card: #141414;
            --text: #e0e0e0;
            --border: #222222;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text);
            font-family: 'Courier New', Courier, monospace;
            padding: 20px;
            line-height: 1.6;
        }

        header {
            text-align: center;
            margin-bottom: 40px;
            border-bottom: 2px dashed var(--primary);
            padding-bottom: 20px;
        }

        h1 {
            color: var(--primary);
            font-size: 2.5rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            text-shadow: 0 0 10px rgba(0, 255, 102, 0.3);
        }

        .subtitle {
            color: #888;
            font-size: 0.9rem;
            margin-top: 5px;
        }

        .featured-link {
            background: linear-gradient(135deg, #111, #1a1a1a);
            border: 2px solid var(--primary);
            border-radius: 8px;
            padding: 25px;
            text-align: center;
            max-width: 800px;
            margin: 0 auto 40px auto;
            box-shadow: 0 0 15px rgba(0, 255, 102, 0.1);
        }

        .featured-link h2 {
            color: var(--primary);
            margin-bottom: 10px;
        }

        .btn {
            display: inline-block;
            background-color: var(--primary);
            color: #000;
            padding: 12px 30px;
            text-decoration: none;
            font-weight: bold;
            border-radius: 4px;
            margin-top: 15px;
            transition: all 0.3s ease;
            text-transform: uppercase;
        }

        .btn:hover {
            background-color: #00cc52;
            box-shadow: 0 0 15px var(--primary);
            transform: translateY(-2px);
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
            max-width: 1200px;
            margin: 0 auto;
        }

        .card {
            background-color: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 6px;
            padding: 20px;
            transition: border-color 0.3s ease;
        }

        .card:hover {
            border-color: var(--primary);
        }

        .card h3 {
            color: var(--primary);
            margin-bottom: 12px;
            border-bottom: 1px solid var(--border);
            padding-bottom: 5px;
        }

        .card ul {
            list-style: none;
        }

        .card ul li {
            margin-bottom: 8px;
        }

        .card ul li a {
            color: #aaa;
            text-decoration: none;
            font-size: 0.9rem;
            transition: color 0.2s ease;
        }

        .card ul li a:hover {
            color: var(--primary);
            padding-left: 5px;
        }

        footer {
            text-align: center;
            margin-top: 50px;
            color: #555;
            font-size: 0.8rem;
        }
    </style>
</head>
<body>

    <header>
        <h1>// Security & Research Hub //</h1>
        <p class="subtitle">System Status: Operational | Terminal: Active</p>
    </header>

    <!-- Requested Target Link -->
    <div class="featured-link">
        <h2>Primary Gateway</h2>
        <p>Access the main project workspace and custom documentation deployment.</p>
        <a href="https://github.io" target="_blank" class="btn">Launch comihacher.github.io</a>
    </div>

    <!-- Hacker Resource Grid -->
    <div class="grid">
        
        <!-- OSINT & Recon -->
        <div class="card">
            <h3>01. Intelligence & Recon</h3>
            <ul>
                <li><a href="https://shodan.io" target="_blank">&gt; Shodan (IoT Search Engine)</a></li>
                <li><a href="https://censys.io" target="_blank">&gt; Censys (Attack Surface)</a></li>
                <li><a href="https://crt.sh" target="_blank">&gt; Crt.sh (Certificate Search)</a></li>
                <li><a href="https://domaintools.com" target="_blank">&gt; DomainTools WHOIS</a></li>
            </ul>
        </div>

        <!-- Vulnerability Databases -->
        <div class="card">
            <h3>02. Exploitation & Vulns</h3>
            <ul>
                <li><a href="https://exploit-db.com" target="_blank">&gt; Exploit Database</a></li>
                <li><a href="https://mitre.org" target="_blank">&gt; MITRE CVE Search</a></li>
                <li><a href="https://packetstormsecurity.com" target="_blank">&gt; Packet Storm Security</a></li>
                <li><a href="https://github.com" target="_blank">&gt; Payloads All The Things</a></li>
            </ul>
        </div>

        <!-- Practice Labs -->
        <div class="card">
            <h3>03. Wargames & Labs</h3>
            <ul>
                <li><a href="https://hackthebox.com" target="_blank">&gt; Hack The Box</a></li>
                <li><a href="https://tryhackme.com" target="_blank">&gt; TryHackMe</a></li>
                <li><a href="https://overthewire.org" target="_blank">&gt; OverTheWire (Linux Basics)</a></li>
                <li><a href="https://portswigger.net" target="_blank">&gt; PortSwigger Web Academy</a></li>
            </ul>
        </div>

        <!-- Online Tooling -->
        <div class="card">
            <h3>04. Web Utilities</h3>
            <ul>
                <li><a href="https://cyberchef.io" target="_blank">&gt; CyberChef (The Swiss Army Knife)</a></li>
                <li><a href="https://dnsdumpster.com" target="_blank">&gt; DNSDumpster</a></li>
                <li><a href="https://revshells.com" target="_blank">&gt; Reverse Shell Generator</a></li>
                <li><a href="https://jwt.io" target="_blank">&gt; JWT Debugger</a></li>
            </ul>
        </div>

        <!-- Documentation & Handbooks -->
        <div class="card">
            <h3>05. Cheat Sheets</h3>
            <ul>
                <li><a href="https://github.io" target="_blank">&gt; GTFOBins (Linux Privilege Escalation)</a></li>
                <li><a href="https://github.io" target="_blank">&gt; LOLBAS (Windows Living Off The Land)</a></li>
                <li><a href="https://owasp.org" target="_blank">&gt; OWASP Cheat Sheets</a></li>
            </ul>
        </div>

        <!-- Threat Intel -->
        <div class="card">
            <h3>06. Threat Intelligence</h3>
            <ul>
                <li><a href="https://virustotal.com" target="_blank">&gt; VirusTotal (File/URL Analysis)</a></li>
                <li><a href="https://urlscan.io" target="_blank">&gt; URLScan.io</a></li>
                <li><a href="https://alienvault.com" target="_blank">&gt; AlienVault OTX</a></li>
            </ul>
        </div>

    </div>

    <footer>
        <p>Authorized Use Only. Maintain operational security at all times.</p>
    </footer>

</body>
</html>
