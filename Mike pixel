<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mike Pixel | Deep Directory Registry</title>
    <style>
        /* CSS Reset & Adaptive Color Variables */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --bg-base: #070a13;
            --bg-card: #0f1524;
            --bg-input: #0b0d16;
            --border-ui: #1e293b;
            --text-main: #f8fafc;
            --text-alt: #94a3b8;
            --accent-glow: #3b82f6;
            --accent-success: #10b981;
        }

        body {
            background-color: var(--bg-base);
            background-image: 
                radial-gradient(circle at 50% -20%, rgba(59, 130, 246, 0.15) 0%, transparent 50%),
                radial-gradient(circle at 10% 80%, rgba(16, 185, 129, 0.04) 0%, transparent 40%);
            color: var(--text-main);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 20px;
        }

        /* App Framework Core Shell */
        .app-shell {
            width: 100%;
            max-w: 680px;
            background: var(--bg-card);
            border: 1px solid var(--border-ui);
            border-radius: 24px;
            padding: 40px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
            position: relative;
        }

        /* Branding Block with Active Blink Node */
        .app-brand {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 28px;
        }

        .brand-title {
            font-size: 1.75rem;
            font-weight: 900;
            letter-spacing: -0.04em;
            text-transform: uppercase;
        }

        .brand-title span {
            color: var(--accent-glow);
        }

        .node-indicator {
            display: flex;
            align-items: center;
            gap: 8px;
            background: #02040a;
            padding: 6px 12px;
            border-radius: 20px;
            border: 1px solid var(--border-ui);
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-alt);
        }

        .blink-dot {
            width: 8px;
            height: 8px;
            background-color: var(--accent-glow);
            border-radius: 50%;
            position: relative;
        }

        .blink-dot::after {
            content: '';
            position: absolute;
            width: 100%;
            height: 100%;
            background-color: var(--accent-glow);
            border-radius: 50%;
            animation: pulseWave 1.8s cubic-bezier(0.215, 0.610, 0.355, 1) infinite;
            top: 0;
            left: 0;
        }

        @keyframes pulseWave {
            0% { transform: scale(0.6); opacity: 1; }
            80%, 100% { transform: scale(3); opacity: 0; }
        }

        /* Functional Tab Array Controller */
        .tab-bar {
            display: flex;
            border-bottom: 1px solid var(--border-ui);
            margin-bottom: 24px;
            gap: 16px;
        }

        .tab-btn {
            background: transparent;
            border: none;
            outline: none;
            color: var(--text-alt);
            font-size: 0.9rem;
            font-weight: 600;
            padding-bottom: 12px;
            cursor: pointer;
            position: relative;
            transition: color 0.2s ease;
        }

        .tab-btn.active {
            color: var(--text-main);
        }

        .tab-btn.active::after {
            content: '';
            position: absolute;
            bottom: -1px;
            left: 0;
            width: 100%;
            height: 2px;
            background-color: var(--accent-glow);
        }

        /* Query Form Engine */
        .search-form {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .input-group {
            display: flex;
            background: var(--bg-input);
            border: 1px solid var(--border-ui);
            border-radius: 12px;
            padding: 4px;
            transition: border-color 0.2s ease;
        }

        .input-group:focus-within {
            border-color: var(--accent-glow);
        }

        .search-input {
            flex: 1;
            background: transparent;
            border: none;
            outline: none;
            color: var(--text-main);
            font-size: 0.95rem;
            padding: 12px 16px;
        }

        .search-input::placeholder {
            color: #475569;
        }

        .submit-btn {
            background: var(--accent-glow);
            color: #ffffff;
            border: none;
            outline: none;
            padding: 14px 28px;
            font-size: 0.9rem;
            font-weight: 700;
            border-radius: 10px;
            cursor: pointer;
            transition: filter 0.2s ease;
        }

        .submit-btn:hover {
            filter: brightness(1.15);
        }

        /* Results Screen Layer */
        .results-wrapper {
            margin-top: 32px;
            border-top: 1px dashed var(--border-ui);
            padding-top: 24px;
            display: none;
        }

        .results-title {
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-alt);
            margin-bottom: 16px;
        }

        .result-card {
            background: #0b0f19;
            border: 1px solid rgba(255,255,255,0.02);
            border-radius: 12px;
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .data-row {
            display: flex;
            justify-content: space-between;
            font-size: 0.85rem;
            border-bottom: 1px solid rgba(255,255,255,0.02);
            padding-bottom: 8px;
        }

        .data-row:last-child {
            border: none;
            padding: 0;
        }

        .label {
            color: var(--text-alt);
        }

        .val {
            font-weight: bold;
            color: var(--text-main);
        }

        .val-secure {
            color: var(--accent-success);
        }
    </style>
</head>
<body>

    <div class="app-shell">
        <!-- App Header Branding Block -->
        <header class="app-brand">
            <h1 class="brand-title">Mike<span>Pixel</span></h1>
            <div class="node-indicator">
                <div class="blink-dot"></div>
                Directory Engine Online
            </div>
        </header>

        <!-- Interface Tabs -->
        <div class="tab-bar">
            <button class="tab-btn active" id="tabPhone" onclick="switchMode('phone')">Reverse Phone Lookup</button>
            <button class="tab-btn" id="tabName" onclick="switchMode('name')">Find by Name</button>
        </div>

        <!-- Directory Search Form Module -->
        <form class="search-form" id="directoryForm" onsubmit="executeRegistryQuery(event)">
            <div class="input-group">
                <input type="text" id="targetQuery" class="search-input" placeholder="Enter target phone number (e.g., +1 555-0192)..." required>
            </div>
            <button type="submit" class="submit-btn" id="actionBtn">Query Registry</button>
        </form>

        <!-- Dynamic Output Results Grid -->
        <div class="results-wrapper" id="resultsSection">
            <h3 class="results-title">Registry Output Log</h3>
            <div class="result-card">
                <div class="data-row">
                    <span class="label">Identified Subject:</span>
                    <span class="val" id="resName">--</span>
                </div>
                <div class="data-row">
                    <span class="label">Primary Phone Asset:</span>
                    <span class="val" id="resPhone">--</span>
                </div>
                <div class="data-row">
                    <span class="label">Carrier Infrastructure:</span>
                    <span class="val" id="resCarrier">--</span>
                </div>
                <div class="data-row">
                    <span class="label">Registry Status:</span>
                    <span class="val val-secure">VERIFIED_MATCH</span>
                </div>
            </div>
        </div>
    </div>

    <script>
        let currentMode = 'phone';

        // Toggles input state and modes within the view block
        function switchMode(mode) {
            currentMode = mode;
            document.getElementById('tabPhone').classList.toggle('active', mode === 'phone');
            document.getElementById('tabName').classList.toggle('active', mode === 'name');
            
            const inputField = document.getElementById('targetQuery');
            if(mode === 'phone') {
                inputField.placeholder = "Enter target phone number (e.g., +1 555-0192)...";
            } else {
                inputField.placeholder = "Enter target full name (e.g., Michael Pixel)...";
            }
            document.getElementById('resultsSection').style.display = 'none';
        }

